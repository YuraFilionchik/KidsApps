{
  "name": "kidsapps",
  "private": true,
  "description": "Тесты и инструменты для детских игр. Сама игра работает без сборки.",
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kidsapp \"node --test tests/rules/*.test.js\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-kidsapp \"node --test --test-concurrency=1 tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:rules && npm run test:e2e"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.19.0",
    "playwright": "1.56.1"
  }
}
