{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "tests/**",
      "README.md"
    ],
    "headers": [
      { "source": "**/*.@(js|css|html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(svg|png|jpg|webp)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}
